gle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 2132480061, "version": 1, "versionNonce": 346094056, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Nunca un solo número que parezca oficial. El rango se cierra a medida que más pacientes tienen folio.", "originalText": "Nunca un solo número que parezca oficial. El rango se cierra a medida que más pacientes tienen folio.", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "baseline": 13, "autoResize": true}, {"id": "e48", "type": "rectangle", "x": 30, "y": 790, "width": 420, "height": 150, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 714537755, "version": 1, "versionNonce": 1929245187, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e49", "type": "text", "x": 42, "y": 800, "width": 110.00000000000001, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1725048951, "version": 1, "versionNonce": 1193309984, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "VERIFICADA", "originalText": "VERIFICADA", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "baseline": 18, "autoResize": true}, {"id": "e50", "type": "text", "x": 42, "y": 831.0, "width": 277.20000000000005, "height": 70.0, "angle": 0, "strokeC