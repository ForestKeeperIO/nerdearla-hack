angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 231897702, "version": 1, "versionNonce": 1961269854, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Regla \"Esto no se suma\": atenciones + participaciones → error explicado, nunca un número.     Celdas de personas menores a 5 se muestran como <5.", "originalText": "Regla \"Esto no se suma\": atenciones + participaciones → error explicado, nunca un número.     Celdas de personas menores a 5 se muestran como <5.", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "baseline": 14, "autoResize": true}, {"id": "e63", "type": "text", "x": 30, "y": 992, "width": 1501.5000000000002, "height": 18.75, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1685254564, "version": 1, "versionNonce": 1709696036, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Caso de la guía con los datos sembrados: 120 atenciones · 80 participaciones · 15 personas en ambos archivos (10 idénticas, 5 con el nombre escrito distinto → 5 pares por confirmar).", "originalText": "Caso de la guía con los datos sembrados: 120 atenciones · 80 participaciones · 15 personas en ambos archivos (10 idénticas, 5 con el nombre escrito distinto → 5 pares por confirmar).", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "baseline": 13, "autoResize": true}, {"id": "e64", "type": "text", "x": 30, "y": 1020, "width": 957.0000000000001, "height": 18.75, "angle": 0, "strokeColor": "#495057", 